{
	"schemaVersion": 1,
	"id": "walksylib",
	"version": "${version}",
	"name": "Walksy Lib",
	"description": "A config library for Walksy's mods",
	"authors": [
		"Walksy"
	],
	"contact": {
		"issues": "https://github.com/Walksy/WalksyLib/issues",
		"sources": "https://github.com/Walksy/WalksyLib",
		"homepage": "https://modrinth.com/mod/walksylib"
	},
	"license": "MIT",
	"icon": "assets/walksylib/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"main.walksy.lib.core.WalksyLibEntrypoint"
		],
		"modmenu": [
			"main.walksy.lib.core.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"walksylib.mixins.json"
	],
	"accessWidener": "walksylib.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}"
	},
	"recommends": {
		"modmenu": "*"
	},
	"breaks": {
		"ambience": "<2.2.0",
		"anchoroptimizer": "<1.3.0",
		"clientkits": "<2.1.0",
		"clientprojectiles": "<1.1.0",
		"consumableoptimizer": "<2.2.3",
		"crossbowoptimizer": "<1.1.0",
		"crosshairaddons": "<2.2.0",
		"customhitboxes": "<3.0.0",
		"nodeathanimation": "<2.1.0",
		"rebindquickswap": "<2.1.0",
		"shieldfixes": "<2.1.0",
		"shieldstatus": "<4.2.0",
		"speareffects": "<1.1.0",
		"walksypopchams": "<1.1.0",
		"rawinputbuffer": "<1.2.0"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.com/invite/zeu7uNuBWY"
			}
		}
	}
}
